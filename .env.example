# Copy to .env.local for local `vercel dev`, and set these in the Vercel
# dashboard (Production + Preview). None of these are ever exposed to the client.

# Google Gemini API key (restrict it to the Generative Language API in Google
# Cloud and set a budget alert to cap cost).
GEMINI_API_KEY=

# Optional: pin the model. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Discord webhook that receives prompt-injection alerts with the transcript.
DISCORD_WEBHOOK_URL=

# Honeypot baits — high-entropy, ALPHANUMERIC ONLY (no spaces/punctuation).
# The bot is told never to reveal these; if either appears in a reply, someone
# succeeded at prompt injection and you get a Discord alert.
HONEYPOT_CANARY=JPOSINT7F3D2A91C4E8
HONEYPOT_DECOY_ID=OMEGA4471X
